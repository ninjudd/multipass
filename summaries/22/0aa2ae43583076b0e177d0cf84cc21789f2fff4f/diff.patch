+            }
+            if rng.below(2) == 0 {
+                history.otps.push(Previous {
+                    replaced: rng.below(modified + 1),
+                    value: otps[rng.below(2) as usize].into(),
+                });
+            }
+            let mut version = Version {
+                modified,
+                entry,
+                removed,
+                history,
+            };
+            version.normalize();
+            store.versions.insert(name.into(), version);
+        }

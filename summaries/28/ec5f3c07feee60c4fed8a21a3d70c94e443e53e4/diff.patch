@@ -0,0 +1,124 @@
+name: Release
+
+# Publishes v<version>, the version in Cargo.toml, when a merge to main
+# changes Cargo.toml, and by hand for the first release or after a run that
+# failed. The design is docs/projects/installer/readme.md § 2.5.
+on:
+  push:
+    branches: [main]
+    paths: [Cargo.toml]
+  workflow_dispatch:
+
+# Each job asks for only what it needs.
+permissions: {}
+
+concurrency:
+  group: release
+  cancel-in-progress: false
+
+env:
+  # Change this only in a pull request of its own; see AGENTS.md.
+  RUST_VERSION: 1.97.1
+
+jobs:
+  build:
+    # A pinned image, so the Xcode linker and SDK the build info records
+    # change only when this line does.
+    runs-on: macos-15
+    permissions:
+      contents: read
+    outputs:
+      version: ${{ steps.version.outputs.version }}
+      publish: ${{ steps.version.outputs.publish }}
+    steps:
+      # The attestation records the ref the run started from, and the
+      # installer accepts only main, so a run from any other ref could never
+      # publish a binary anyone installs.
+      - name: Refuse any ref but main
+        if: github.ref != 'refs/heads/main'
+        run: |
+          echo "::error::releases run only on refs/heads/main, not $GITHUB_REF"
+          exit 1
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
+        with:
+          persist-credentials: false
+      - name: Read the version
+        id: version
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          version="$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -n 1)"
+          echo "version=$version" >>"$GITHUB_OUTPUT"
+          draft="$(gh release view "v$version" --repo "$GITHUB_REPOSITORY" --json isDraft --jq .isDraft 2>/dev/null || true)"
+          if [ "$draft" = false ]; then
+            echo "v$version is already published, so there is nothing to release"
+            echo "publish=false" >>"$GITHUB_OUTPUT"
+          else
+            echo "publish=true" >>"$GITHUB_OUTPUT"
+          fi
+      # The runner image ships rustup, so installing the toolchain needs no
+      # third-party action.
+      - name: Install Rust
+        if: steps.version.outputs.publish == 'true'
+        run: |
+          rustup toolchain install "$RUST_VERSION" --profile minimal \
+            --target aarch64-apple-darwin --target x86_64-apple-darwin
+          rustup default "$RUST_VERSION"
+      - name: Build twice and compare
+        if: steps.version.outputs.publish == 'true'
+        run: .github/scripts/build-release.sh dist
+      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        if: steps.version.outputs.publish == 'true'
+        with:
+          name: release
+          path: dist/
+          if-no-files-found: error
+          retention-days: 7
+
+  # This job can write releases and sign attestations, so it never checks out
+  # the repository and runs none of its code.
+  publish:
+    needs: build
+    if: needs.build.outputs.publish == 'true'
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+      id-token: write
+      attestations: write
+    env:
+      VERSION: ${{ needs.build.outputs.version }}
+    steps:
+      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          name: release
+          path: dist
+      - uses: actions/attest-build-provenance@4d101475d8b20a2381f78447822ac1eab6504dd8 # v4.2.2
+        id: attest
+        with:
+          subject-path: |
+            dist/multipass-${{ needs.build.outputs.version }}-macos
+            dist/install.sh
+      - name: Publish the release
+        env:
+          GH_TOKEN: ${{ github.token }}
+          GH_REPO: ${{ github.repository }}
+          BUNDLE: ${{ steps.attest.outputs.bundle-path }}
+        run: |
+          # The bundle's name carries no version, so
+          # releases/latest/download/multipass.sigstore.json always names the
+          # newest release's bundle.
+          cp "$BUNDLE" dist/multipass.sigstore.json
+          tag="v$VERSION"
+          if [ "$(gh release view "$tag" --json isDraft --jq .isDraft 2>/dev/null || true)" = true ]; then
+            gh release delete "$tag" --yes
+          fi
+          # A draft takes every asset before anything is public, and
+          # publishing it creates the tag at this commit. Immutable releases
+          # then lock the tag and the assets.
+          gh release create "$tag" --draft --target "$GITHUB_SHA" --title "multipass $VERSION" --generate-notes \
+            "dist/multipass-$VERSION-macos" \
+            dist/install.sh \
+            dist/multipass.sigstore.json \
+            dist/SHA256SUMS \
+            "dist/multipass-$VERSION.buildinfo"
+          gh release edit "$tag" --draft=false

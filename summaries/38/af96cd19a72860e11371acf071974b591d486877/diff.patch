+[ "$STATUS" = 0 ] || fail "vercel-api.sh exited $STATUS for a 200"
+[ "$OUT" = '{"deploymentId":"dpl_1"}' ] || fail "vercel-api.sh printed $OUT for a 200"
+grep -qx 'https://api.vercel.com/v4/aliases/example.dev?teamId=team_1' "$FAKE/argv" ||

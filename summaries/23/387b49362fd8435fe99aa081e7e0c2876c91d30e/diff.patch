+                if all_sets && limit.is_none_or(|l| longest <= l) {
+                    count += 1;
+                }
+            }
+            let expected = (count as f64).log2();
+            assert!(
+                (entropy(&Recipe::Chars(chars)) - expected).abs() < 1e-9,
+                "limit {limit:?}: {count}"

+        for _ in 0..draws {
+            counts[below(94, &mut source).unwrap()] += 1;
+        }
+        let expected = draws as f64 / 94.0;
+        let sd = (expected * (1.0 - 1.0 / 94.0)).sqrt();
+        for (i, &c) in counts.iter().enumerate() {
+            assert!((c as f64 - expected).abs() < 5.0 * sd, "index {i}: {c}");
+        }

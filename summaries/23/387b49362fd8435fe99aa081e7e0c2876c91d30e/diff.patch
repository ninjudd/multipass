+        // requirements and the run limit.
+        let cells: [&[u8]; 4] = [b"ABC", b"de", b"45", b"!"];
+        for limit in [None, Some(1), Some(2)] {
+            let chars = Chars {
+                length: 4,
+                max_consecutive: limit,
+                ..sets(&cells)
